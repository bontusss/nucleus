meta {
  name: Create a branch
  type: http
  seq: 5
}

post {
  url: {{baseURI}}org/branch
  body: json
  auth: none
}

headers {
  {{var}}: {{key}}
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "Main22 branch",
    "country": "Nigeria",
    "business_id": 14,
    "address": "23 Haba road",
    "metadata": {"industry":"hospitality","tier":"gold","founded":2024}
  }
}

settings {
  encodeUrl: true
}

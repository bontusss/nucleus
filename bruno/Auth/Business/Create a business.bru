meta {
  name: Create a business
  type: http
  seq: 6
}

post {
  url: {{baseURI}}org
  body: json
  auth: none
}

headers {
  "{{var}}": {{key}}
  Authorization: Bearer {{token}}
}

body:json {
  {
    "name": "test business",
    "email": "testemail1@mail.com",
    "country": "nigeria"
  }
}

body:multipart-form {
  name: Majeckul hotels
  country: Nigeria
  logo: @file(/home/bontus/Downloads/logo.jpg)
  metadata: {"industry":"hospitality","tier":"gold","founded":2024}
  email: test90@email.com
}

settings {
  encodeUrl: true
}
